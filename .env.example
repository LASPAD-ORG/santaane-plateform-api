# =============================================================================
# SANTAANE API - ENVIRONMENT VARIABLES CONFIGURATION
# =============================================================================
# Copy this file to .env and update the values for your environment
# IMPORTANT: Never commit .env file to version control!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# For Docker: use pgbouncer service name on port 5432 (internal container port)
# For local development: use localhost:6432 (exposed port)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@pgbouncer:5432/santaane

# PostgreSQL Database Credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=santaane

# =============================================================================
# JWT AUTHENTICATION CONFIGURATION
# =============================================================================
# IMPORTANT: Change SECRET_KEY to a secure random string in production
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
APP_NAME=Santaane API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Comma-separated list of allowed origins for CORS
# Add your frontend URLs here
CORS_ORIGINS=*

# =============================================================================
# PAGINATION CONFIGURATION
# =============================================================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
