# =============================================================================
# SANTAANE API - PRODUCTION ENVIRONMENT VARIABLES FOR COOLIFY
# =============================================================================
# This file contains all environment variables needed for Coolify deployment.
# Configure these values in Coolify's UI under Environment Variables.
#
# IMPORTANT: Never commit actual production values to version control!
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# =============================================================================
# Database connection URL for the API (direct connection to PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:your-secure-password@db:5432/santaane

# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-change-this
POSTGRES_DB=santaane

# =============================================================================
# JWT AUTHENTICATION CONFIGURATION (REQUIRED)
# =============================================================================
# CRITICAL: Generate a strong secret key for production!
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING-IN-PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
APP_NAME=Santaane API
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Comma-separated list of allowed origins for CORS
# IMPORTANT: Set this to your frontend domain in production
# Example: https://app.santaane.com,https://www.santaane.com
CORS_ORIGINS=https://your-frontend-domain.com

# =============================================================================
# PAGINATION CONFIGURATION
# =============================================================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# =============================================================================
# COOLIFY-SPECIFIC NOTES
# =============================================================================
# 1. In Coolify UI, set the domain for the 'api' service (e.g., api.santaane.com)
# 2. Coolify will automatically handle HTTPS/SSL certificates via Let's Encrypt
# 3. The compose file uses required variables syntax (:?) for critical configs
# 4. Internal services (db) are not exposed externally
# 5. Only the 'api' service will be accessible from the internet
#
# Required Variables (must be set before deployment):
#   - POSTGRES_PASSWORD
#   - SECRET_KEY
#
# These will show with a red border in Coolify's UI if not set.
# =============================================================================
