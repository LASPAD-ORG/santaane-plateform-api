# Futuristic box drawing
print_box_top() {
    echo -e "${PURPLE}╔══════════════════════════════════════════════════════════════╗${NC}"
}

print_box_middle() {
    local text="$1"
    local padding=$(( (60 - ${#text}) / 2 ))
    printf "${PURPLE}║${NC}%*s${NEON_BLUE}${BOLD}%s${NC}%*s${PURPLE}║${NC}\n" $padding "" "$text" $padding ""
}

print_box_bottom() {
    echo -e "${PURPLE}╚══════════════════════════════════════════════════════════════╝${NC}"
}

# Function to print colored messages with icons
print_success() {
    echo -e "${NEON_GREEN}${BOLD}[✓]${NC} ${NEON_GREEN}$1${NC}"
}

print_info() {
    echo -e "${NEON_BLUE}${BOLD}[→]${NC} ${CYAN}$1${NC}"
}

print_warning() {
    echo -e "${YELLOW}${BOLD}[⚠]${NC} ${ORANGE}$1${NC}"
}

print_error() {
    echo -e "${RED}${BOLD}[✗]${NC} ${RED}$1${NC}"
}

print_progress() {
    echo -e "${MAGENTA}${BOLD}[◆]${NC} ${PINK}$1${NC}"
}

print_header() {
    echo ""
    print_box_top
    print_box_middle "$1"
    print_box_bottom
    echo ""
}

# Function to check if Docker is running
check_docker() {
    if ! docker info > /dev/null 2>&1; then
        print_error "Docker n'est pas en cours d'exécution!"
        exit 1
    fi
}

# Function to check if services are running
check_running() {
    if docker-compose ps | grep -q "santaane_api.*Up"; then
        return 0
    else
        return 1
    fi
}

