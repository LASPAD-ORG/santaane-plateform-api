}

# Stop services
stop_services() {
    print_header "Arrêt des services"
    check_docker

    if check_running; then
        print_info "Arrêt des services..."
        $DOCKER_COMPOSE down
        print_success "Services arrêtés"
    else
        print_warning "Les services ne sont pas en cours d'exécution"
    fi
}

# Restart services
restart_services() {
    print_header "Redémarrage des services"
    check_docker
    print_info "Redémarrage..."
    $DOCKER_COMPOSE restart
    print_success "Services redémarrés"
}

# Rebuild and restart
rebuild_services() {
    print_header "Rebuild des services"
    check_docker
    print_info "Arrêt des services..."
    $DOCKER_COMPOSE down
    print_info "Rebuild en cours..."
    $DOCKER_COMPOSE up -d --build
    print_success "Rebuild terminé et services redémarrés"
}

# Apply migrations
apply_migrations() {
    print_header "Application des migrations"
    check_docker

    if ! check_running; then
        print_error "Les services ne sont pas démarrés"
        print_info "Utilisez './santaane start' d'abord"
        exit 1
    fi

    print_info "Application des migrations..."
    $DOCKER_COMPOSE exec api poetry run alembic upgrade head
    print_success "Migrations appliquées"
}

# Create new migration
make_migrations() {
    print_header "Génération d'une migration"
    check_docker

    if ! check_running; then
        print_error "Les services ne sont pas démarrés"
        print_info "Utilisez './santaane start' d'abord"
        exit 1
    fi

    read -p "Nom de la migration (laisser vide pour générer automatiquement): " migration_name

    if [ -z "$migration_name" ]; then
        # Générer un nom automatique basé sur la date et l'heure
        migration_name="auto_migration_$(date +%Y%m%d_%H%M%S)"
        print_info "Nom automatique généré: $migration_name"
    fi

    print_info "Génération de la migration '$migration_name'..."
    $DOCKER_COMPOSE exec api poetry run alembic revision --autogenerate -m "$migration_name"
    print_success "Migration générée"
}

