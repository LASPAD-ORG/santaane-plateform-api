# Seed countries from a JSON file
seed_countries() {
    print_header "Peuplement des pays"
    check_docker

    if ! check_running; then
        print_error "Les services ne sont pas démarrés"
        print_info "Utilisez './santaane start' d'abord"
        exit 1
    fi

    # Demander le chemin du fichier JSON
    echo -ne "${NEON_BLUE}📂 Chemin du fichier JSON (ex: slim-2.json):${NC} "
    read json_file

    if [ ! -f "$json_file" ]; then
        print_error "Fichier introuvable: $json_file"
        exit 1
    fi

    print_progress "Lecture des données depuis $json_file..."

    # Copier le fichier dans le conteneur API
    docker cp "$json_file" santaane_api:/tmp/countries.json

    print_progress "Insertion des pays dans la base de données..."

    # Exécuter un script Python asynchrone à l'intérieur du conteneur API
    $DOCKER_COMPOSE exec -T api poetry run python - << EOF
import json
import asyncio
from sqlmodel import select
from sqlalchemy.ext.asyncio import AsyncSession
from app.db import engine
from app.models.country import Country

async def seed():
    async with AsyncSession(engine) as session:
        with open("/tmp/countries.json", "r", encoding="utf-8") as f:
            data = json.load(f)

        for c in data:
            name = c.get("name")
            code = c.get("alpha-2") or c.get("alpha-3")
            if not name:
                continue

            result = await session.execute(select(Country).where(Country.name == name))
            existing = result.scalars().first()
            if not existing:
                session.add(Country(name=name, code=code))

        await session.commit()
        print(f"{len(data)} pays insérés ou mis à jour avec succès !")

asyncio.run(seed())
EOF

    print_success "Peuplement terminé !"
}

# Seed cities from a JSON file
seed_cities() {
    print_header "Peuplement des villes"
    check_docker

    if ! check_running; then
        print_error "Les services ne sont pas démarrés"
        print_info "Utilisez './santaane start' d'abord"
        exit 1
    fi

    # Demander le chemin du fichier JSON
    echo -ne "${NEON_BLUE}📂 Chemin du fichier JSON (ex: cities.json):${NC} "
    read json_file

    if [ ! -f "$json_file" ]; then
        print_error "Fichier introuvable: $json_file"
        exit 1
    fi

    print_progress "Lecture des données depuis $json_file..."

    # Copier le fichier dans le conteneur API
    docker cp "$json_file" santaane_api:/tmp/cities.json

    print_progress "Insertion des villes dans la base de données..."

    # Script Python exécuté dans le conteneur
    $DOCKER_COMPOSE exec -T api poetry run python - << EOF
import json
import asyncio
from sqlmodel import select
from app.models.city import City
from app.models.country import Country
from app.db import AsyncSessionLocal

async def seed():
    # Lire le JSON
    with open("/tmp/cities.json", "r", encoding="utf-8") as f:
        data = json.load(f)

    # Créer un mapping country_code -> country_id
    async with AsyncSessionLocal() as session:
        countries = await session.execute(select(Country))
        country_map = {c.code: c.id for c in countries.scalars().all()}

        batch = []
        for c in data:
            country_id = country_map.get(c["country"])
            if country_id is None:
                continue  # ignore si le pays n'existe pas
            city = City(
                name=c["name"],
                country_id=country_id
            )
            batch.append(city)

        session.add_all(batch)
        await session.commit()
        print(f"{len(batch)} villes insérées avec succès !")

asyncio.run(seed())
EOF

    print_success "Peuplement terminé !"
}



