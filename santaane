# Reset database
reset_db() {
    print_header "Réinitialisation de la base de données"
    check_docker

    print_warning "ATTENTION: Cette action va SUPPRIMER toutes les données!"
    read -p "Êtes-vous sûr? Tapez 'RESET' pour confirmer: " confirm

    if [ "$confirm" = "RESET" ]; then
        print_info "Arrêt des services..."
        $DOCKER_COMPOSE down
        print_info "Suppression du volume de la base de données..."
        docker volume rm santaane-plateform-api_pgdata 2>/dev/null || true
        print_info "Redémarrage des services..."
        $DOCKER_COMPOSE up -d --build
        print_success "Base de données réinitialisée"
    else
        print_info "Réinitialisation annulée"
    fi
}

# Dump database
dump_db() {
    print_header "Dump de la base de données"
    check_docker

    if ! check_running; then
        print_error "Les services ne sont pas démarrés"
        print_info "Utilisez './santaane start' d'abord"
        exit 1
    fi

    # Create dumps directory with timestamp
    TIMESTAMP=$(date +%Y%m%d_%H%M%S)
    DUMP_DIR="dumps/${TIMESTAMP}"
    mkdir -p "$DUMP_DIR"

    print_info "Création du dump dans $DUMP_DIR..."

    # Dump the database
    $DOCKER_COMPOSE exec -T db pg_dump -U postgres santaane > "$DUMP_DIR/santaane_dump.sql"

    if [ $? -eq 0 ]; then
        # Get dump size
        DUMP_SIZE=$(du -h "$DUMP_DIR/santaane_dump.sql" | cut -f1)

        print_success "Dump créé avec succès!"
        echo ""
        echo -e "${NEON_BLUE}${BOLD}  ┌─────────────────────────────────────────────┐${NC}"
        echo -e "${NEON_BLUE}${BOLD}  │${NC}  ${CYAN}Fichier${NC}   → ${NEON_GREEN}$DUMP_DIR/santaane_dump.sql${NC}"
        echo -e "${NEON_BLUE}${BOLD}  │${NC}  ${CYAN}Taille${NC}    → ${NEON_GREEN}${DUMP_SIZE}${NC}"
        echo -e "${NEON_BLUE}${BOLD}  │${NC}  ${CYAN}Date${NC}      → ${NEON_GREEN}$(date '+%Y-%m-%d %H:%M:%S')${NC}"
        echo -e "${NEON_BLUE}${BOLD}  └─────────────────────────────────────────────┘${NC}"
        echo ""
        print_info "Pour restaurer: ${MAGENTA}./santaane db-restore${NC}"
    else
        print_error "Échec de la création du dump"
        rm -rf "$DUMP_DIR"
        exit 1
    fi
}

# Restore database from dump
restore_db() {
    print_header "Restauration de la base de données"
    check_docker

    if ! check_running; then
        print_error "Les services ne sont pas démarrés"
        print_info "Utilisez './santaane start' d'abord"
        exit 1
    fi

    # Check if dumps directory exists
    if [ ! -d "dumps" ]; then
        print_error "Aucun dump trouvé (dossier 'dumps' n'existe pas)"
        exit 1
    fi

    # List available dumps
    print_info "Dumps disponibles:"
    echo ""

    DUMPS=($(ls -1dt dumps/*/ 2>/dev/null))

    if [ ${#DUMPS[@]} -eq 0 ]; then
        print_error "Aucun dump trouvé dans le dossier 'dumps'"
        exit 1
    fi

    # Display dumps with index
    for i in "${!DUMPS[@]}"; do
        DUMP_NAME=$(basename "${DUMPS[$i]}")
        DUMP_FILE="${DUMPS[$i]}santaane_dump.sql"

        if [ -f "$DUMP_FILE" ]; then
            DUMP_SIZE=$(du -h "$DUMP_FILE" | cut -f1)
            echo -e "  ${NEON_BLUE}[$((i+1))]${NC} ${CYAN}$DUMP_NAME${NC} ${GRAY}(${DUMP_SIZE})${NC}"
        fi
    done

    echo ""
    echo -ne "${NEON_BLUE}Sélectionnez le dump à restaurer (1-${#DUMPS[@]}):${NC} "
    read DUMP_INDEX

    # Validate input
    if ! [[ "$DUMP_INDEX" =~ ^[0-9]+$ ]] || [ "$DUMP_INDEX" -lt 1 ] || [ "$DUMP_INDEX" -gt ${#DUMPS[@]} ]; then
        print_error "Sélection invalide"
        exit 1
    fi

    SELECTED_DUMP="${DUMPS[$((DUMP_INDEX-1))]}santaane_dump.sql"

    if [ ! -f "$SELECTED_DUMP" ]; then
        print_error "Fichier de dump introuvable: $SELECTED_DUMP"
        exit 1
    fi

    print_warning "ATTENTION: Cette action va ÉCRASER toutes les données actuelles!"
    read -p "Continuer? (y/N): " confirm

    if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
        print_info "Restauration en cours..."

        # Arrêter l'API pour libérer les connexions
        print_info "Arrêt temporaire de l'API..."
        $DOCKER_COMPOSE stop api

        # Terminer toutes les connexions actives
        $DOCKER_COMPOSE exec -T db psql -U postgres -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = 'santaane' AND pid <> pg_backend_pid();" > /dev/null 2>&1

        # Drop and recreate database
        $DOCKER_COMPOSE exec -T db psql -U postgres -c "DROP DATABASE IF EXISTS santaane;" > /dev/null 2>&1
        $DOCKER_COMPOSE exec -T db psql -U postgres -c "CREATE DATABASE santaane;" > /dev/null 2>&1

        # Restore dump
        print_info "Importation du dump..."
        cat "$SELECTED_DUMP" | $DOCKER_COMPOSE exec -T db psql -U postgres santaane > /dev/null 2>&1

        if [ $? -eq 0 ]; then
            # Redémarrer l'API
            print_info "Redémarrage de l'API..."
            $DOCKER_COMPOSE start api

            print_success "Base de données restaurée avec succès!"
            print_info "N'oubliez pas d'appliquer les migrations si nécessaire: ${MAGENTA}./santaane migrate${NC}"
        else
            print_error "Échec de la restauration"
            $DOCKER_COMPOSE start api
            exit 1
        fi
    else
        print_info "Restauration annulée"
    fi
}

