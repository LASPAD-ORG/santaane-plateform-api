    echo -e "  ${NEON_GREEN}║${NC}  ${PINK}logs-db${NC}              ${GRAY}→${NC} Logs PostgreSQL"
    echo -e "  ${NEON_GREEN}║${NC}  ${PINK}logs-all${NC}             ${GRAY}→${NC} Tous les logs"
