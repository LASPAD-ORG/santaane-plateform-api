# Rollback migration
rollback_migration() {
    print_header "Rollback de migration"
    check_docker

    if ! check_running; then
        print_error "Les services ne sont pas démarrés"
        exit 1
    fi

    print_warning "Attention: Cette action va annuler la dernière migration"
    read -p "Continuer? (y/N): " confirm

    if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
        print_info "Rollback en cours..."
        $DOCKER_COMPOSE exec api poetry run alembic downgrade -1
        print_success "Rollback effectué"
    else
        print_info "Rollback annulé"
    fi
}

# Clear alembic version table (DANGEROUS)
clear_alembic_version() {
    print_header "⚠️  VIDER LA TABLE ALEMBIC_VERSION"
    check_docker

    if ! check_running; then
        print_error "Les services ne sont pas démarrés"
        print_info "Utilisez './santaane start' d'abord"
        exit 1
    fi

    echo ""
    print_error "╔════════════════════════════════════════════════════════════╗"
    print_error "║                    ⚠️  DANGER  ⚠️                          ║"
    print_error "╚════════════════════════════════════════════════════════════╝"
    echo ""
    print_warning "Cette action va SUPPRIMER l'historique des migrations Alembic!"
    echo ""
    echo -e "${YELLOW}${BOLD}Conséquences:${NC}"
    echo -e "${GRAY}  • Alembic ne saura plus quelles migrations ont été appliquées${NC}"
    echo -e "${GRAY}  • Vous devrez recréer l'historique manuellement${NC}"
    echo -e "${GRAY}  • Les données de la base NE SERONT PAS supprimées${NC}"
    echo -e "${GRAY}  • Utile uniquement pour recommencer avec des migrations propres${NC}"
    echo ""
    print_warning "À n'utiliser que si vous savez ce que vous faites!"
    echo ""

    read -p "Êtes-vous ABSOLUMENT sûr? Tapez 'CLEAR-ALEMBIC' pour confirmer: " confirm

    if [ "$confirm" = "CLEAR-ALEMBIC" ]; then
        print_info "Vidage de la table alembic_version..."

        $DOCKER_COMPOSE exec -T db psql -U postgres santaane -c "TRUNCATE TABLE alembic_version;" > /dev/null 2>&1

        if [ $? -eq 0 ]; then
            print_success "Table alembic_version vidée avec succès!"
            echo ""
            echo -e "${NEON_BLUE}${BOLD}Prochaines étapes:${NC}"
            echo -e "${CYAN}  1. Supprimez les fichiers du dossier alembic/versions/${NC}"
            echo -e "${CYAN}  2. Créez une nouvelle migration: ${MAGENTA}./santaane mk ${NC}"
            echo -e "${CYAN}  3. Appliquez la migration: ${MAGENTA}./santaane migrate${NC}"
            echo ""
        else
            print_error "Échec du vidage de la table alembic_version"
            exit 1
        fi
    else
        print_info "Opération annulée"
    fi
}

